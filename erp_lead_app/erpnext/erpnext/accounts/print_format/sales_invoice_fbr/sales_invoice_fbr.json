 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \r\n\"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" />\r\n<title>Untitled Document</title>\r\n<style type=\"text/css\">\r\n<!--\r\n.style5 { font-size: 14px; font-weight: bold; }\r\n.style7 { font-size: 12px; font-weight: bold; }\r\n.style9 { font-size: 11px; font-weight: bold; }\r\n.style10 { font-size: 11px }\r\n.style11 { font-size: 12px }\r\n.style12 {\r\n\tfont-size: 24px;\r\n\tfont-weight: bold;\r\n}\r\n-->\r\n</style>\r\n</head>\r\n\r\n<body>\r\n<table width=\"100%\">\r\n  <tr>\r\n    <td><div align=\"center\" class=\"style1 style12\">{{ letter_head }}<br />\r\n    SALES TAX INVOICE </div></td>\r\n  </tr>\r\n</table>\r\n<br>\r\n\r\n<table width=\"100%\" border=\"1\" bordercolor=\"#000000\" style=\"line-height:9px\">\r\n  <tr>\r\n    <td width=\"16%\"><span class=\"style9\">Customer Name: </span></td>\r\n    <td width=\"42%\"><span class=\"style10\">{{doc.customer_name or \"\"}}</span></td>\r\n    <td width=\"1%\" style=\"border:none\"></td>\r\n    <td width=\"22%\"><span class=\"style9\">Invoice No.</span></td>\r\n    <td width=\"19%\"><span class=\"style10\">{{doc.name or \"\"}}</span></td>\r\n  </tr>\r\n  <tr>\r\n    <td><span class=\"style10\"><strong>Address:</strong></span></td>\r\n    <td><span class=\"style10\"><span class=\"style10\"><span class=\"style10\"> {{ frappe.get_doc(\"Address\", doc.customer_address).address_line1 }} {{ frappe.get_doc(\"Address\", doc.customer_address).city }} {{ frappe.get_doc(\"Address\", doc.customer_address).state }} {{ frappe.get_doc(\"Address\", doc.customer_address).country }}</span></td>\r\n    <td style=\"border:none\"></td>\r\n    <td><span class=\"style9\">Invoice Date </span></td>\r\n    <td><span class=\"style10\">{{doc.get_formatted('posting_date')}}</span></td>\r\n  </tr>\r\n  <tr>\r\n    <td><span class=\"style10\"><strong>NTN No. </strong></span></td>\r\n    <td><span class=\"style10\">{{doc.tax_id or \"\"}}</span></td>\r\n    <td style=\"border:none\"></td>\r\n    <td><span class=\"style9\">Company NTN/CNIC No. </span></td>\r\n    <td><span class=\"style10\">{{doc.company_tax_id or \"\"}}</span></td>\r\n  </tr>\r\n  <tr>\r\n    <td><span class=\"style10\"><strong>STRN No. </strong></span></td>\r\n    <td><span class=\"style10\">{{ frappe.get_doc(\"Customer\", doc.customer).custom_custom_strn }}</span></td>\r\n    <td style=\"border:none\"></td>\r\n    <td><span class=\"style9\">Company STRN No. </span></td>\r\n    <td><span class=\"style10\">{{ frappe.get_doc(\"Company\", doc.company).custom_strn }}</span></td>\r\n  </tr>\r\n\r\n  <tr>\r\n    <td><span class=\"style10\"><strong>Remarks:</strong></span></td>\r\n    <td colspan=\"4\"><span class=\"style10\">{{doc.remarks or \"\"}}</span></td>\r\n  </tr>\r\n</table>\r\n\r\n<p class=\"style5 style11\">Item Detail :</p>\r\n\r\n<table width=\"100%\" border=\"1\" style=\"line-height:9px\">\r\n  <tr>\r\n    <td align=\"center\" class=\"style10\"><strong>Sr.No.</strong></td>\r\n    <td align=\"left\" class=\"style10\"><strong>Item Name</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>Description</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>HSCode</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>Unit</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>Quantity</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>Rate</strong></td>\r\n    <td align=\"center\" class=\"style10\"><strong>Value</strong></td>\r\n  </tr>\r\n\r\n  {% for i in doc.items %}\r\n  <tr>\r\n    <td align=\"center\" class=\"style10\">{{i.idx}}</td>\r\n    <td align=\"left\" class=\"style10\">{{i.item_name}}</td>\r\n    <td align=\"left\" class=\"style10\">{{i.description}}</td>\r\n    <td align=\"center\" class=\"style10\">{{i.custom_hs_code}}</td>\r\n    <td align=\"center\" class=\"style10\">{{i.uom}}</td>\r\n    <td align=\"center\" class=\"style10\">{{i.qty}}</td>\r\n    <td align=\"right\" class=\"style10\">{{i.rate}}</td>\r\n    <td align=\"right\" class=\"style10\">{{i.get_formatted('amount')}}</td>\r\n  </tr>\r\n  {% endfor %}\r\n</table>\r\n\r\n{% if doc.taxes and doc.taxes|length > 0 %}\r\n<p class=\"style7\">Taxes:</p>\r\n\r\n<table width=\"100%\" border=\"1\" style=\"line-height:7px\">\r\n  <tr>\r\n    <td width=\"64%\" class=\"style10\"><strong>Tax Section Name</strong></td>\r\n    <td width=\"36%\" align=\"center\" class=\"style10\"><strong>Tax Amount</strong></td>\r\n  </tr>\r\n\r\n  {% for i in doc.taxes %}\r\n  <tr>\r\n    <td class=\"style10\">{{ i.description }}</td>\r\n    <td align=\"right\" class=\"style10\">{{ i.get_formatted('tax_amount') }}</td>\r\n  </tr>\r\n  {% endfor %}\r\n</table>\r\n{% endif %}\r\n\r\n<br>\r\n\r\n<table width=\"100%\" style=\"line-height:9px\">\r\n  <tr>\r\n    <td width=\"65%\" rowspan=\"3\">\r\n      <span class=\"style10\"><strong>Grand Total (In Word):</strong><br><br>\r\n      <strong>{{doc.in_words}}</strong></span>    </td>\r\n    <td width=\"19%\" style=\"border:1px solid #000\"><span class=\"style10\"><strong>Total :</strong></span></td>\r\n    <td width=\"16%\" style=\"border:1px solid #000\"><span class=\"style10\">{{doc.get_formatted('total')}}</span></td>\r\n  </tr>\r\n  <tr>\r\n    <td style=\"border:1px solid #000\"><span class=\"style10\"><strong>Taxes :</strong></span></td>\r\n    <td style=\"border:1px solid #000\"><span class=\"style10\">{{doc.get_formatted('total_taxes_and_charges')}}</span></td>\r\n  </tr>\r\n  <tr>\r\n    <td style=\"border:1px solid #000\"><span class=\"style10\"><strong>Grand Total :</strong></span></td>\r\n    <td style=\"border:1px solid #000\"><span class=\"style10\"><strong>{{doc.get_formatted('grand_total')}}</strong></span></td>\r\n  </tr>\r\n</table>\r\n\r\n<table width=\"100%\">\r\n    <tr>\r\n      <td rowspan=\"3\">             </td>\r\n      <td rowspan=\"3\"></td>\r\n     <td rowspan=\"3\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td width=\"17%\">&nbsp;</td>\r\n      <td width=\"20%\">&nbsp;</td>\r\n    </tr>\r\n    <tr>\r\n      <td><img src=\"https://fbr.vfg.com.pk/private/files/fbr%20logo.jpg\" align=\"top\" style=\" width:70%; height:auto;\" /></td>\r\n      <td><img \r\n            src=\"https://api.qrserver.com/v1/create-qr-code/?data={{ doc.custom_fbr_invoice_no }}\" \r\n            style=\"width: 60%; height: auto;\" \r\n            alt=\"QR Code\"\r\n        /></td>\r\n    </tr>\r\n    \r\n\t<tr><td colspan=\"3\"><div align=\"right\" class=\"style11\"><strong>FBR  Invoice No: </strong></div></td>\r\n\t  <td colspan=\"2\"><span class=\"style11\"><strong>{{doc.custom_fbr_invoice_no or \"\"}}</strong></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n<!-- \u2705 ADDED FOOTER -->\r\n<footer style='position:fixed;bottom:0'>\r\n<table width=\"100%\" style=\"margin-top:10px;\">\r\n  <tr>\r\n    <td width=\"21%\"><span class=\"style7\">Page No:</span></td>\r\n    <td width=\"43%\"><span class=\"style11\" id=\"pageNo\"></span></td>\r\n    <td width=\"16%\"><span class=\"style7\">Print Date Time:</span></td>\r\n    <td width=\"20%\"><span class=\"style11\" id=\"printDate\"></span></td>\r\n  </tr>\r\n</table>\r\n</footer>\r\n\r\n<!-- \u2705 ADDED SCRIPT -->\r\n<script type=\"text/javascript\">\r\nwindow.onbeforeprint = function () {\r\n    var now = new Date();\r\n    document.getElementById(\"printDate\").innerHTML =\r\n        now.toLocaleDateString() + \" \" + now.toLocaleTimeString();\r\n    document.getElementById(\"pageNo\").innerHTML = \"1\";\r\n};\r\n</script>\r\n\r\n</body>\r\n</html>\r\n",

 "font_size": 14,
 "html": "<style>\r\n.heading-main {\r\n\tfont:Verdana, Geneva, sans-serif;\r\n\tfont-size:36px;\r\n\tfont-weight:bolder;\r\n\ttext-align:center;}\r\n.heading-small {\r\n\tfont:Verdana, Geneva, sans-serif;\r\n\tfont-size:12px;\r\n\tfont-weight:bolder;\r\n}\r\n</style>\r\n\r\n<table width=\"100%%\" border=\"0\">\r\n  <tr>\r\n    <td width=\"20%\" rowspan=\"2\"><img src=\"https://erp.omchouse.com/files/Head.logob817a5.png\" width=\"101\" height=\"89\"></td>\r\n  \r\n  </tr>\r\n  <tr>\r\n    <td width=\"60%\" class=\"heading-main\"><div style=\"vertical-align:middle\">OMC TAX</div></td>\r\n    <td width=\"20%\" class=\"heading-main\">&nbsp;</td>\r\n  </tr>\r\n  <tr>\r\n  </tr>\r\n</table><br><br><br><br>\r\n<table width=\"100%%\" border=\"0\">\r\n  <tr>\r\n    <td width=\"30%\" class=\"heading-small\">Customer Name</td>\r\n    <td width=\"20%\">&nbsp;</td>\r\n    <td width=\"10%\">&nbsp;</td>\r\n    <td width=\"10%\" class=\"heading-small\">Inv#</td>\r\n    <td width=\"30%\">{{doc.name}}</td>\r\n  </tr>\r\n  <tr>\r\n    <td>{{doc.customer}}</td>\r\n    <td>&nbsp;</td>\r\n    <td>&nbsp;</td>\r\n    <td class=\"heading-small\">Date</td>\r\n    <td>{{doc.get_formatted('posting_date')}}</td>\r\n  </tr>\r\n</table>\r\n<table width=\"100%%\" border=\"2\">\r\n  <tr>\r\n    <td width=\"70%\" align=\"center\" class=\"heading-small\">Description</td>\r\n    <td width=\"30%\" align=\"center\" class=\"heading-small\">Amount</td>\r\n  </tr>\r\n  {%- for items in doc.items -%}\r\n  <tr>\r\n    <td>{{items.item_name}}</td>\r\n    <td align=\"center\">{{items.get_formatted('amount')}}</td>\r\n  </tr>\r\n  {%- endfor -%}\r\n</table>\r\n<table width=\"101%%\" border=\"0\">\r\n  <tr>\r\n    <td width=\"70%\" valign=\"top\">Remarks: {{doc.remarks}}</td>\r\n    <td width=\"30%\"><table width=\"100%%\" border=\"1\">\r\n  <tr>\r\n    \r\n    <td width=\"16%\"><strong>Sub Total</strong></td>\r\n    <td width=\"18%\">{{doc.get_formatted('total')}}</td>\r\n  </tr>\r\n  <tr>\r\n    <td><strong>SRB</strong></td>\r\n    <td>{{doc.get_formatted('total_taxes_and_charges')}}</td>\r\n  </tr>\r\n  <tr>\r\n    <td><strong>Grand Total</strong></td>\r\n    <td>{{doc.get_formatted('grand_total')}}</td>\r\n  </tr>\r\n</table></td>\r\n  </tr>\r\n</table>\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
